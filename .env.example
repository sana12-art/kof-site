# --- Site (facultatif) ---
# Par défaut, le site appelle les fonctions Vercel du dossier /api (même adresse).
# Ne définir cette variable que pour utiliser une autre API.
# REACT_APP_API_URL=

# --- Fonctions Vercel (à définir dans Vercel > Settings > Environment Variables) ---
# Clé API Resend (resend.com > API Keys)
RESEND_API_KEY=
# Adresse qui reçoit les demandes des formulaires
CONTACT_TO_EMAIL=
# Facultatif : expéditeur (nécessite un domaine vérifié dans Resend). Défaut : onboarding@resend.dev
# MAIL_FROM=KOF-EXPERTS <contact@kof-experts.com>
