# KOF-EXPERTS - configuration Apache pour le site React (SPA) + API PHP.
# Ce fichier doit rester à la racine du dossier publié (là où se trouve index.html).

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Ne jamais toucher aux appels vers /api/*.php (formulaires).
  RewriteRule ^api/ - [L]

  # Ne pas réécrire les fichiers et dossiers qui existent réellement
  # (images, css, js, pdfs, etc.).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Toutes les autres routes (/services, /apropos, /creation-entreprise, ...)
  # sont gérées par React Router : on renvoie index.html.
  RewriteRule ^ index.html [L]
</IfModule>

# Mise en cache longue des fichiers statiques versionnés (noms avec hash).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

# index.html ne doit jamais être mis en cache, sinon les mises à jour du site
# n'apparaissent pas pour les visiteurs.
<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
